<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>eskf</name>
  <version>2.0.0</version>
  <description>Error-state Kalman filter</description>
  <maintainer email="talha104choudhry@gmail.com">talhanc</maintainer>
  <license>MIT</license>

  <!-- Buildsystem tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Core ROS 2 Components -->
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>

  <!-- Standard ROS 2 Messages -->
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>

  <!-- Coordinate Transforms & Math Math Libraries -->
  <depend>eigen3</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>

  <depend>std_msgs</depend>
  <depend>vortex_utils</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
