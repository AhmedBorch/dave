<?xml version="1.0"?>
<sdf version="1.7">
  <model name="lauv">
    <!-- <static>false</static> -->
    
    <!-- Main body link -->
    <link name="base_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>18.0</mass>
        <inertia>
          <ixx>2.6244000000000005</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>3.0617999877528</iyy>
          <iyz>0</iyz>
          <izz>3.0617999877528</izz>
        </inertia>
      </inertial>
      
      <visual name="base_link_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://meshes/lauv/body.dae</uri>
          </mesh>
        </geometry>
      </visual>
      
      <collision name="base_link_collision">
        <pose>0 0 0.0 0 0 0</pose>
        <geometry>
          <box>
             <size>0.95 0.14 0.14</size>
          </box>
        </geometry>
      </collision>

      <!-- IMU sensor -->
      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>100.0</update_rate>
        <topic>/model/lauv/imu</topic>
      </sensor>
    </link>

    <!-- Pressure sensor -->
    <link name="pressure_link">
      <pose>0 0 -0.06 0 0 0</pose> <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-05</iyy>
          <iyz>0</iyz>
          <izz>1e-05</izz>
        </inertia>
      </inertial>
    </link>

    <joint name="pressure_joint" type="fixed">
      <parent>base_link</parent>
      <child>pressure_link</child>
    </joint>

    <!-- DVL -->
     <link name="dvl_link">
      <pose>0.0 0 -0.04 0 0 0</pose>
      <velocity_decay />
      <gravity>1</gravity>
      <velocity_decay />

      <sensor
        name="nortek_dvl500_300" type="custom"
        gz:type="dvl">
        <pose>0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>8</update_rate>
        <topic>/model/lauv/dvl/velocity</topic>
        <gz:dvl>
          <type>phased_array</type>
          <arrangement degrees="true">
            <beam id="1">
              <aperture>3</aperture>
              <rotation>-135</rotation>
              <tilt>25</tilt>
            </beam>
            <beam>
              <aperture>3</aperture>
              <rotation>135</rotation>
              <tilt>25</tilt>
            </beam>
            <beam>
              <aperture>3</aperture>
              <rotation>45</rotation>
              <tilt>25</tilt>
            </beam>
            <beam>
              <aperture>3</aperture>
              <rotation>-45</rotation>
              <tilt>25</tilt>
            </beam>
          </arrangement>
          <tracking>
            <water_mass_mode>
              <when>best</when>
              <water_velocity>
                <x>0.</x>
                <y>0.</y>
                <z>0.</z>
              </water_velocity>
              <boundaries>
                <near>10.</near>
                <far>100.</far>
              </boundaries>
              <bins>10</bins>
              <noise type="gaussian">
                <stddev>0.015</stddev>
              </noise>
              <visualize>true</visualize>
            </water_mass_mode>
            <bottom_mode>
              <when>best</when>
              <noise type="gaussian">
                <stddev>0.005</stddev>
              </noise>
              <visualize>true</visualize>
            </bottom_mode>
          </tracking>
          <maximum_range>200.</maximum_range>
          <minimum_range>0.3</minimum_range>
          <!-- ENU to FSD -->
          <reference_frame>0 0 0 3.14 0 -1.57</reference_frame>
        </gz:dvl>
      </sensor>

      <self_collide>0</self_collide>
      <enable_wind>0</enable_wind>
      <kinematic>0</kinematic>

      <visual name="dvl_link_visual">
        <pose>0 0 0 0 0 3.14159</pose>
        <geometry>
          <mesh>
            <scale>0.25 0.25 0.25</scale>
            <!-- Mesh is actually for a Nortek DVL1000-4000m for now -->
            <uri>model://meshes/nortek_dvl500_300/DVL500-300m.dae</uri>
          </mesh>
        </geometry>
        <transparency>0</transparency>
        <cast_shadows>1</cast_shadows>
      </visual>
      

    </link>

    <joint name="dvl_joint" type="fixed">
      <parent>base_link</parent>
      <child>dvl_link</child>
    </joint>


    <!-- Thruster link -->
    <link name="thruster_0">
      <pose>-0.53994 0 0 0 0 3.14159</pose>
      <inertial>
        <mass>0.1</mass>
        <pose>0 0 0 0 0 0</pose>
        <inertia>
          <ixx>0.000000017</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.000000017</iyy>
          <iyz>0.0</iyz>
          <izz>0.000000017</izz>
        </inertia>
      </inertial>
      
      <visual name="thruster_0_visual">
        <geometry>
          <mesh>
            <uri>model://meshes/lauv/propeller.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>

      <collision name="thruster_0_collision">
        <geometry>
          <box>
             <size>0.009756 0.1 0.1</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- Fin links -->
    <link name="fin_0">
      <pose>-0.4 0 0.04 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <pose>0 0 0 0 0 0</pose>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      
      <visual name="fin_0_visual">
        <geometry>
          <mesh>
            <uri>model://meshes/lauv/red_fin.dae</uri>
          </mesh>
        </geometry>
      </visual>
      
      <collision name="fin_0_collision">
        <geometry>
          <box>
             <size>0.1 0.00487804 0.1</size>
          </box>
        </geometry>
      </collision>
    </link>

    <link name="fin_1">
      <pose>-0.4 -0.04 0 1.5708 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <pose>0 0 0 0 0 0</pose>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      
      <visual name="fin_1_visual">
        <geometry>
          <mesh>
            <uri>model://meshes/lauv/black_fin.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <collision name="fin_1_collision">
        <geometry>
          <box>
             <size>0.1 0.00487804 0.1</size>
          </box>
        </geometry>
      </collision>
    </link>

    <link name="fin_2">
      <pose>-0.4 0 -0.04 3.14159 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <pose>0 0 0 0 0 0</pose>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      
      <visual name="fin_2_visual">
        <geometry>
          <mesh>
            <uri>model://meshes/lauv/black_fin.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <collision name="fin_2_collision">
        <geometry>
          <box>
             <size>0.1 0.00487804 0.1</size>
          </box>
        </geometry>
      </collision>
    </link>

    <link name="fin_3">
      <pose>-0.4 0.04 0 -1.5708 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <pose>0 0 0 0 0 0</pose>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      
      <visual name="fin_3_visual">
        <geometry>
          <mesh>
            <uri>model://meshes/lauv/black_fin.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <collision name="fin_3_collision">
        <geometry>
          <box>
             <size>0.1 0.00487804 0.1</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- Joints -->
    <joint name="thruster_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster_0</child>
      <pose>-0.53994 0 0 0 0 3.14159</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <joint name="fin_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>fin_0</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.396263402</lower>
          <upper>1.396263402</upper>
          <effort>-1</effort>
          <velocity>-1</velocity>
        </limit>
      </axis>
    </joint>

    <joint name="fin_1_joint" type="revolute">
      <parent>base_link</parent>
      <child>fin_1</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.396263402</lower>
          <upper>1.396263402</upper>
          <effort>-1</effort>
          <velocity>-1</velocity>
        </limit>
      </axis>
    </joint>

    <joint name="fin_2_joint" type="revolute">
      <parent>base_link</parent>
      <child>fin_2</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.396263402</lower>
          <upper>1.396263402</upper>
          <effort>-1</effort>
          <velocity>-1</velocity>
        </limit>
      </axis>
    </joint>

    <joint name="fin_3_joint" type="revolute">
      <parent>base_link</parent>
      <child>fin_3</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.396263402</lower>
          <upper>1.396263402</upper>
          <effort>-1</effort>
          <velocity>-1</velocity>
        </limit>
      </axis>
    </joint>

    <!-- Thruster plugin -->
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <namespace>lauv</namespace>
      <joint_name>thruster_0_joint</joint_name>
      <thrust_coefficient>0.02</thrust_coefficient>
      <fluid_density>1025.0</fluid_density>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>false</use_angvel_cmd>
    </plugin>

    <!-- Fin plugin -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <air_density>1000</air_density>
      <cla>4.13</cla>
      <cla_stall>-1.1</cla_stall>
      <cda>0.2</cda>
      <cda_stall>0.03</cda_stall>
      <alpha_stall>0.17</alpha_stall>
      <a0>0</a0>
      <area>0.0244</area>
      <upward>0 1 0</upward>
      <forward>1 0 0</forward>
      <link_name>fin_0</link_name>
      <cp>0 0 0</cp>
    </plugin>

    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <air_density>1000</air_density>
      <cla>4.13</cla>
      <cla_stall>-1.1</cla_stall>
      <cda>0.2</cda>
      <cda_stall>0.03</cda_stall>
      <alpha_stall>0.17</alpha_stall>
      <a0>0</a0>
      <area>0.0244</area>
      <upward>0 1 0</upward>
      <forward>1 0 0</forward>
      <link_name>fin_1</link_name>
      <cp>0 0 0</cp>
    </plugin>

    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <air_density>1000</air_density>
      <cla>4.13</cla>
      <cla_stall>-1.1</cla_stall>
      <cda>0.2</cda>
      <cda_stall>0.03</cda_stall>
      <alpha_stall>0.17</alpha_stall>
      <a0>0</a0>
      <area>0.0244</area>
      <upward>0 1 0</upward>
      <forward>1 0 0</forward>
      <link_name>fin_2</link_name>
      <cp>0 0 0</cp>
    </plugin>

    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <air_density>1000</air_density>
      <cla>4.13</cla>
      <cla_stall>-1.1</cla_stall>
      <cda>0.2</cda>
      <cda_stall>0.03</cda_stall>
      <alpha_stall>0.17</alpha_stall>
      <a0>0</a0>
      <area>0.0244</area>
      <upward>0 1 0</upward>
      <forward>1 0 0</forward>
      <link_name>fin_3</link_name>
      <cp>0 0 0</cp>
    </plugin>

    <!-- Hydrodynamics plugin -->
    <plugin filename="gz-sim-hydrodynamics-system" name="gz::sim::systems::Hydrodynamics">
      <namespace>lauv</namespace>
      <link_name>base_link</link_name>
      <water_density>1025.0</water_density>

      <!-- Added mass -->
      <xDotU>1</xDotU>
      <yDotV>16</yDotV>
      <zDotW>16</zDotW>
      <kDotP>0.005</kDotP>
      <mDotQ>1.3</mDotQ>
      <nDotR>1.3</nDotR>

      <!-- Linear Drag Coefficients -->
      <!-- diagonal terms -->
      <xU>-2.4</xU>
      <yV>-23</yV>
      <zW>-23</zW>
      <kP>-0.3</kP>
      <mQ>-9.7</mQ>
      <nR>-9.7</nR>

      <!-- Quadratic Drag Coefficients -->
      <xUabsU>-2.4</xUabsU>
      <yVabsV>-80</yVabsV>
      <zWabsW>-80</zWabsW>
      <kPabsP>-0.0006</kPabsP>
      <mQabsQ>-9.1</mQabsQ>
      <nRabsR>-9.1</nRabsR>

    </plugin>

    <!-- Joint state publisher plugin -->
    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
    </plugin>

    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>fin_0_joint</joint_name>
      <topic>/model/lauv/joint/fin_0_joint/cmd_pos</topic>
      <p_gain>0.1</p_gain>
    </plugin>

    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>fin_1_joint</joint_name>
      <topic>/model/lauv/joint/fin_1_joint/cmd_pos</topic>
      <p_gain>0.1</p_gain>
    </plugin>

    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>fin_2_joint</joint_name>
      <topic>/model/lauv/joint/fin_2_joint/cmd_pos</topic>
      <p_gain>0.1</p_gain>
    </plugin>

    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>fin_3_joint</joint_name>
      <topic>/model/lauv/joint/fin_3_joint/cmd_pos</topic>
      <p_gain>0.1</p_gain>
    </plugin>

    <!-- Odometry publisher plugin -->
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_frame>map</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>100</odom_publish_frequency>
    </plugin>

    <!-- Sensors -->
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <plugin
      filename="sea_pressure_sensor"
      name="dave_gz_sensor_plugins::SubseaPressureSensorPlugin">
      <namespace>lauv</namespace>
      <topic>sea_pressure</topic>
      <update_rate>10</update_rate>
      <noise_sigma>3.0</noise_sigma>
      <estimate_depth_on>true</estimate_depth_on>
      <standard_pressure>101.325</standard_pressure>
      <kPa_per_meter>9.80638</kPa_per_meter>
    </plugin>

    <plugin
      filename="DVLBridge"
      name="dave_ros_gz_plugins::DVLBridge">
      <topic>/model/lauv/dvl/velocity</topic>
    </plugin>

  </model>
</sdf>
