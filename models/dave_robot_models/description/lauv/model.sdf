      </inertial>
      
      <visual name="fin_2_visual">
        <geometry>
          <mesh>
            <uri>model://meshes/lauv/black_fin.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <link name="fin_3">
      <pose>-0.4 0.04 0 -1.5708 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <pose>0 0 0 0 0 0</pose>
