      </inertial>
      
      <visual name="fin_3_visual">
        <geometry>
          <mesh>
            <uri>model://meshes/lauv/black_fin.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link> -->

    <!-- Joints -->
    <joint name="thruster_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster_0</child>
      <pose>-0.53994 0 0 0 0 3.14159</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <joint name="fin_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>fin_0</child>
      <pose>-0.4 0 0.04 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.5708</lower>
          <upper>1.5708</upper>
        </limit>
      </axis>
    </joint>

    <!-- <joint name="fin_1_joint" type="revolute">
      <parent>base_link</parent>
      <child>fin_1</child>
      <pose>-0.4 -0.04 0 1.5708 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
