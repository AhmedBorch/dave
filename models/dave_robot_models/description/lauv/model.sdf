<?xml version="1.0"?>
<sdf version="1.7">
  <model name="lauv">
    <static>false</static>
    
    <!-- Main body link -->
    <link name="base_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>18.0</mass>
        <inertia>
          <ixx>2.6244000000000005</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>3.0617999877528</iyy>
          <iyz>0</iyz>
          <izz>3.0617999877528</izz>
        </inertia>
      </inertial>
      
      <visual name="base_link_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://meshes/lauv/body.dae</uri>
          </mesh>
        </geometry>
      </visual>
      
      <collision name="base_link_collision">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <!-- <cylinder>
            <radius>0.2</radius>
            <length>1.2</length>
          </cylinder> -->
          <box>
            <!-- <size>0.075 0.075 1.08</size> -->
             <size>0.15 0.15 1.1</size>
          </box>
        </geometry>
      </collision>

      <!-- IMU sensor -->
      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>100.0</update_rate>
        <topic>/model/lauv/imu</topic>
      </sensor>
    </link>

    <!-- Thruster link -->
     <!-- <xacro:thruster_macro robot_namespace="${namespace}" thruster_id="0">
        <origin xyz="-0.53994 0 0" rpy="0 0 ${pi}" />
    </xacro:thruster_macro> -->
    <link name="thruster_0">
      <pose>-0.53994 0 0 0 0 3.14159</pose>
      <inertial>
        <mass>0.1</mass>
        <pose>0 0 0 0 0 0</pose>
        <inertia ixx="0.000000017" ixy="0.0" ixz="0.0"
               iyy="0.000000017" iyz="0.0"
               izz="0.000000017" />
      </inertial>
      
      <visual name="thruster_0_visual">
        <geometry>
          <mesh>
            <uri>model://meshes/lauv/propeller.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
    </link>

    <!-- Fin links -->
    <link name="fin_0">
      <pose>-0.4 0 0.04 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <pose>0 0 0 0 0 0</pose>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      
      <visual name="fin_0_visual">
        <geometry>
          <mesh>
            <uri>model://meshes/lauv/red_fin.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <!-- <link name="fin_1">
      <pose>-0.4 -0.04 0 1.5708 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <pose>0 0 0 0 0 0</pose>
        <inertia>
          <ixx>0.0001</ixx>
