      </inertial>
      
      <visual name="fin_1_visual">
        <geometry>
          <mesh>
            <uri>model://meshes/lauv/black_fin.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <link name="fin_2">
      <pose>-0.4 0 -0.04 3.14159 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <pose>0 0 0 0 0 0</pose>
